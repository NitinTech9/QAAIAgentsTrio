{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QA agents framework project config",
  "description": "Schema for .claude/project-config.json. Referenced via the config's $schema key so editors validate and autocomplete it; /doctor and /qa-help check the same rules.",
  "type": "object",
  "required": ["project"],
  "properties": {
    "$schema": { "type": "string" },
    "project": {
      "type": "object",
      "required": ["name", "testFramework", "paths", "auth", "app", "runCommand"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "testFramework": { "enum": ["cypress", "playwright"] },
        "dbVerification": {
          "type": "boolean",
          "description": "false = suite has no direct DB access; DB-assertion-on-mutation checks are skipped (degraded standard)",
          "default": true
        },
        "ticketSource": {
          "type": "object",
          "description": "Where tickets are read from and test cases written back to. See .claude/guides/ticket-sources.md. `type` selects the branch; only that source's sub-block needs to be filled in.",
          "required": ["type"],
          "additionalProperties": true,
          "properties": {
            "type": { "enum": ["jira", "github", "azure", "clickup", "none"] },
            "none": {
              "type": "object",
              "properties": {
                "outputDir": { "type": "string", "minLength": 1 }
              }
            },
            "jira": { "$ref": "#/definitions/jiraBlock" },
            "github": {
              "type": "object",
              "properties": {
                "repo": {
                  "type": "string",
                  "pattern": "^[^/]+/[^/]+$",
                  "description": "owner/repo"
                },
                "testLabel": { "type": "string" }
              }
            },
            "azure": {
              "type": "object",
              "properties": {
                "organization": { "type": "string" },
                "project": { "type": "string" },
                "testWorkItemType": { "type": "string" },
                "tokenEnvVar": {
                  "type": "string",
                  "description": "Name of the env var holding the PAT — never the PAT itself",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                }
              }
            },
            "clickup": {
              "type": "object",
              "properties": {
                "listId": { "type": "string" },
                "tokenEnvVar": {
                  "type": "string",
                  "description": "Name of the env var holding the token — never the token itself",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                }
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "type": { "const": "github" } }, "required": ["type"] },
              "then": { "required": ["github"], "properties": { "github": { "required": ["repo"] } } }
            },
            {
              "if": { "properties": { "type": { "const": "azure" } }, "required": ["type"] },
              "then": { "required": ["azure"], "properties": { "azure": { "required": ["organization", "project"] } } }
            },
            {
              "if": { "properties": { "type": { "const": "clickup" } }, "required": ["type"] },
              "then": { "required": ["clickup"], "properties": { "clickup": { "required": ["listId"] } } }
            },
            {
              "if": { "properties": { "type": { "const": "jira" } }, "required": ["type"] },
              "then": { "required": ["jira"], "properties": { "jira": { "required": ["cloudId"] } } }
            }
          ]
        },
        "jira": {
          "allOf": [{ "$ref": "#/definitions/jiraBlock" }],
          "deprecated": true,
          "description": "DEPRECATED — moved to ticketSource.jira. Read as a fallback so pre-1.0 configs keep working."
        },
        "paths": {
          "type": "object",
          "required": ["ticketContext", "manualCases", "apiTests", "uiTests", "pages", "support", "fixtures", "reports"],
          "properties": {
            "ticketContext": { "type": "string" },
            "manualCases": { "type": "string" },
            "apiTests": { "type": "string" },
            "uiTests": { "type": "string" },
            "jiraTicketTests": { "type": ["string", "null"] },
            "pages": { "type": "string" },
            "support": { "type": "string" },
            "dataFactory": { "type": ["string", "null"] },
            "tasks": { "type": ["string", "null"] },
            "fixtures": { "type": "string" },
            "knowledge": { "type": ["string", "null"] },
            "swaggerPrimary": { "type": ["string", "null"] },
            "swaggerSecondary": { "type": ["string", "null"] },
            "namingConventions": { "type": ["string", "null"] },
            "logs": { "type": ["string", "null"] },
            "reports": { "type": "string" },
            "screenshots": { "type": ["string", "null"] }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "primary": { "$ref": "#/definitions/authBlock" },
            "secondary": { "anyOf": [{ "$ref": "#/definitions/authBlock" }, { "type": "null" }] },
            "loginCommand": { "type": ["string", "null"] },
            "sessionCookieAlias": { "type": ["string", "null"] },
            "csrfTokenAlias": { "type": ["string", "null"] }
          }
        },
        "app": {
          "type": "object",
          "required": ["primaryBaseUrl", "envFile"],
          "properties": {
            "primaryBaseUrl": { "type": "string", "pattern": "^https?://" },
            "secondaryBaseUrl": { "anyOf": [{ "type": "string", "pattern": "^https?://" }, { "type": "null" }] },
            "loginPath": { "type": ["string", "null"] },
            "allowedHosts": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Extra hosts (staging/uat) the browser MCP may navigate to, besides localhost and the primary/secondary baseUrl hosts. Enforced by .claude/hooks/block-risky-mcp.sh."
            },
            "envFile": { "type": "string" },
            "emailKey": { "type": ["string", "null"] },
            "passwordKey": { "type": ["string", "null"] }
          }
        },
        "testLimits": {
          "type": "object",
          "properties": {
            "bugMaxTests": { "type": "integer", "minimum": 1 },
            "storyMaxTests": { "type": "integer", "minimum": 1 }
          }
        },
        "runCommand": {
          "type": "object",
          "required": ["headless"],
          "properties": {
            "headed": { "type": "string" },
            "headless": { "type": "string", "pattern": "\\{specFile\\}" },
            "withEnv": { "type": "string" }
          }
        },
        "runTimeoutMs": { "type": "integer", "minimum": 1000 },
        "knowledge": {
          "type": "object",
          "properties": {
            "behaviorNoteMaxAgeDays": {
              "type": "integer", "minimum": 1, "default": 90,
              "description": "Staleness threshold for known_500_bugs/endpoint_quirks entries (measured from lastVerified). Past it, an entry means re-verify before trusting — never silently skip coverage."
            }
          }
        },
        "productionProtection": {
          "type": "object",
          "description": "Production guardrails enforced at the tool layer: block-risky-bash.sh matches these patterns against shell commands, block-risky-mcp.sh against browser navigation URLs.",
          "properties": {
            "prodUrlPatterns": { "type": "array", "items": { "type": "string" }, "description": "Extended regexes; any match blocks the command/navigation." }
          }
        },
        "productCode": {
          "type": "object",
          "properties": {
            "rootPaths": { "type": "array", "items": { "type": "string" } },
            "stack": {
              "enum": ["go-chi", "go-gin", "express", "nestjs", "django", "fastapi", "rails", "spring-boot", "laravel", "dotnet", "generic"],
              "description": "Key into .claude/stacks/code-patterns.json — selects the route/handler/model/roleGate search patterns for /analyze-code. Must match a top-level key in that file (/qa-selftest checks this).",
              "default": "generic"
            },
            "codePatterns": {
              "type": "object",
              "description": "Per-project regex overrides merged over the stack preset, field by field. Empty arrays mean 'use the preset'.",
              "additionalProperties": true,
              "properties": {
                "route": { "type": "array", "items": { "type": "string" } },
                "handler": { "type": "array", "items": { "type": "string" } },
                "model": { "type": "array", "items": { "type": "string" } },
                "roleGate": { "type": "array", "items": { "type": "string" } }
              }
            },
            "sourceGlobs": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Empty = inherit from the stack preset"
            },
            "excludeDirs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "postman": {
          "type": "object",
          "properties": {
            "collectionsPath": { "type": "string" },
            "authType": { "enum": ["cookie", "bearer", "none"] },
            "loginEndpoint": { "type": ["string", "null"] },
            "csrfEndpoint": { "type": ["string", "null"] }
          }
        }
      }
    }
  },
  "definitions": {
    "jiraBlock": {
      "type": "object",
      "properties": {
        "cloudId": { "type": "string", "minLength": 1 },
        "testIssueType": { "type": "string" },
        "issueLinkType": { "type": "string" },
        "batchSize": { "type": "integer", "minimum": 1 },
        "testAssigneeAccountId": { "type": ["string", "null"] }
      }
    },
    "authBlock": {
      "type": "object",
      "properties": {
        "loginCommand": { "type": ["string", "null"] },
        "sessionCookieAlias": { "type": ["string", "null"] },
        "csrfTokenAlias": { "type": ["string", "null"] }
      }
    }
  }
}
